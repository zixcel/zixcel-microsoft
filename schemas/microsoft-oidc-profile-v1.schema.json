{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zixcel://microsoft/oidc-provider-profile/v1",
  "title": "Zixcel Microsoft OIDC Provider Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "profile_id", "issuer", "client_id", "redirect_uri",
    "scopes", "allowed_methods"
  ],
  "properties": {
    "schema": { "const": "zixcel://microsoft/oidc-provider-profile/v1" },
    "profile_id": { "$ref": "#/$defs/id" },
    "issuer": {
      "type": "string",
      "pattern": "^https://login\\.microsoftonline\\.com/[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}/v2\\.0$",
      "maxLength": 256
    },
    "client_id": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "redirect_uri": {
      "type": "string",
      "pattern": "^http://127\\.0\\.0\\.1:[0-9]{4,5}/auth/callback$"
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "contains": { "const": "openid" },
      "items": { "enum": ["openid", "profile", "email"] }
    },
    "allowed_methods": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "authenticator-passkey", "authenticator-push",
          "fido2-security-key", "totp"
        ]
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
    }
  }
}
