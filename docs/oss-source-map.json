{
  "repository": "zixcel/zixcel-microsoft",
  "purpose": "Check a Microsoft 365 integration configuration and produce a plan before implementing or enabling the connection.",
  "responsibility_boundary": "Own the named reusable integration/data mechanism. Product roles/UI and operational approvals stay with consumers; transport/custody reuse managed Crowsi components where capabilities fit. Planning-only APIs must remain clearly distinguished from implemented external operations.",
  "packages": [
    {
      "manifest": "Cargo.toml",
      "package": "zixcel-microsoft",
      "ecosystem": "rust",
      "description": "Planning and offline-accept Microsoft service connector boundary for Zixcel",
      "interfaces": {
        "lib": "src/lib.rs",
        "features": {},
        "bins": [],
        "public_modules": [
          "mail",
          "sharepoint_daily_report"
        ],
        "public_reexports": [
          "authorization::{\n    AuthorizedConnectorPlan, ProviderPlanRequest, WorkflowAuthorization, build_authorized_plan,\n    parse_provider_plan_request,\n}",
          "boundary::ConnectorError",
          "config::{ConnectorConfig, MicrosoftCloud, MicrosoftWorkload, parse_config}",
          "oidc::{\n    MicrosoftAuthenticationMethod, OidcLoginPlan, OidcLoginRequest, OidcProviderProfile,\n    build_oidc_login_plan,\n}",
          "plan::{ConnectorPlan, PlanStep, build_plan}",
          "reports::{\n    CapabilityReport, DoctorReport, ValidationReport, capabilities, doctor, validation_report,\n}"
        ],
        "implicit_bins": []
      },
      "declared_commands": {}
    },
    {
      "manifest": "package.json",
      "package": "@zixcel/microsoft-mail-presentation",
      "ecosystem": "npm",
      "description": "Credential-free Microsoft mailbox configuration presentation; no authentication or execution",
      "interfaces": {
        "exports": {
          ".": {
            "types": "./presentation/index.d.mts",
            "import": "./presentation/index.mjs"
          }
        },
        "bin": {},
        "main": null,
        "types": "./presentation/index.d.mts"
      },
      "declared_commands": {
        "test": "node --test presentation/test/*.test.mjs",
        "typecheck": "tsc --strict --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 presentation/test/public-types.mts",
        "build": "node --check presentation/index.mjs"
      }
    },
    {
      "manifest": "packages/provider-microsoft/package.json",
      "package": "@zixcel/provider-microsoft",
      "ecosystem": "npm",
      "description": "microsoft local administrator operations with one-use Crowsi authorization",
      "interfaces": {
        "exports": {
          ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
          }
        },
        "bin": {},
        "main": null,
        "types": null
      },
      "declared_commands": {
        "build": "tsc -p tsconfig.json",
        "test": "npm run build && node --test test/*.test.mjs",
        "prepack": "npm test"
      }
    },
    {
      "manifest": "packages/zixcel-microsoft-mail-web/package.json",
      "package": "@zixcel/microsoft-mail-web",
      "ecosystem": "npm",
      "description": "Browser-side Microsoft 365 mailbox source with MSAL and bounded Graph delta synchronization",
      "interfaces": {
        "exports": {
          ".": {
            "types": "./src/index.d.mts",
            "import": "./src/index.mjs"
          },
          "./redirect-document": {
            "import": "./src/redirect-document.mjs",
            "types": "./src/redirect-document.d.mts"
          }
        },
        "bin": {},
        "main": null,
        "types": "./src/index.d.mts"
      },
      "declared_commands": {
        "test": "node --test test/*.test.mjs",
        "typecheck": "tsc --strict --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 test/public-types.mts",
        "build": "node --check src/index.mjs && node --check src/redirect-document.mjs"
      }
    }
  ],
  "schema_definitions": [
    "schemas/README.md",
    "schemas/authorized-connector-plan-v1.schema.json",
    "schemas/mail-request-v1.schema.json",
    "schemas/microsoft-oidc-profile-v1.schema.json",
    "schemas/provider-plan-request-v1.schema.json",
    "schemas/sharepoint-daily-report-plan-v1.schema.json",
    "schemas/sharepoint-daily-report-receipt-v1.schema.json",
    "schemas/sharepoint-daily-report-request-v1.schema.json",
    "schemas/sharepoint-daily-report-request-validation-v1.schema.json"
  ],
  "test_sources": [
    "packages/provider-microsoft/test/control.test.mjs",
    "packages/provider-microsoft/test/discovery.test.mjs",
    "packages/zixcel-microsoft-mail-web/test/mail.test.mjs",
    "packages/zixcel-microsoft-mail-web/test/public-types.mts",
    "presentation/test/presentation.test.mjs",
    "presentation/test/public-types.mts",
    "src/boundary.rs",
    "src/oidc/validation.rs",
    "src/sharepoint_daily_report/digest.rs",
    "src/sharepoint_daily_report/identity.rs",
    "src/sharepoint_daily_report/path_safety.rs",
    "src/sharepoint_daily_report/time.rs",
    "tests/authorization.rs",
    "tests/cli.rs",
    "tests/connector.rs",
    "tests/daily_report_accept.rs",
    "tests/daily_report_plan.rs",
    "tests/mail.rs",
    "tests/oidc_login.rs"
  ],
  "example_sources": [
    "examples/config.toml",
    "examples/department-daily-report-v1.json",
    "examples/mail-request.json",
    "examples/provider-plan-request.json",
    "examples/sharepoint-daily-report-request-v1.json",
    "examples/talent-profile-report-department-daily-20260723.json",
    "examples/talent-profile-report-department-daily-20260723.offline-receipt.json",
    "examples/workflow-authorization-receipt.json",
    "playground/provider-operations/README.ja.md",
    "playground/provider-operations/README.md",
    "playground/provider-operations/demo.mjs"
  ],
